DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=internet_app

# Docker Compose only: host ports the stack is published on.
# DB_HOST must stay "postgres" inside Compose; it is set in docker-compose.yml.
API_PORT=3000
DB_EXPOSED_PORT=5433

# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Keep the generated value in your local .env only.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-client

# Inventory: service name inside the combined Docker network; localhost locally.
INVENTORY_GRPC_URL=127.0.0.1:50051
INVENTORY_PROTO_PATH=proto/inventory.proto
INVENTORY_READ_TIMEOUT_MS=1000
INVENTORY_RESERVE_TIMEOUT_MS=3000
INVENTORY_RELEASE_TIMEOUT_MS=3000
INVENTORY_OPERATION_TIMEOUT_MS=60000
INVENTORY_COMPENSATION_INTERVAL_MS=5000
INVENTORY_COMPENSATION_RETRY_MS=5000
