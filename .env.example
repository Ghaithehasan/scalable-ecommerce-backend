DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=internet_app

# Docker Compose only: host ports the stack is published on.
# DB_HOST must stay "postgres" inside Compose; it is set in docker-compose.yml.
API_PORT=3000
DB_EXPOSED_PORT=5433

# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Keep the generated value in your local .env only.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-client

# Inventory microservice (requirement 2), reached over gRPC.
# Inside Docker Compose use host.docker.internal:50051 when the inventory
# stack runs from its own compose file.
INVENTORY_GRPC_URL=localhost:50051
INVENTORY_RESERVE_TIMEOUT_MS=3000
INVENTORY_READ_TIMEOUT_MS=1500
INVENTORY_RELEASE_TIMEOUT_MS=5000
