{
  "name": "inventory-service",
  "version": "0.1.0",
  "description": "Independent inventory gRPC microservice for the scalable e-commerce backend",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "proto:generate": "buf generate ../proto",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "probe": "ts-node --project tsconfig.scripts.json scripts/grpc-probe.ts",
    "migration:run": "typeorm-ts-node-commonjs --dataSource src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs --dataSource src/database/data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs --dataSource src/database/data-source.ts migration:show",
    "seed": "ts-node --project tsconfig.scripts.json src/database/seed.ts",
    "migration:run:prod": "typeorm --dataSource dist/database/data-source.js migration:run",
    "seed:prod": "node dist/database/seed.js",
    "demo:race": "ts-node --project tsconfig.scripts.json scripts/race-demo.ts",
    "test:race": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js race"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@grpc/reflection": "1.0.4",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/microservices": "12.3.2",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^17.2.3",
    "grpc-health-check": "2.1.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "jest": "30.5.2",
    "oxlint": "1.90.0",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "ts-proto": "2.18.4",
    "typescript": "6.0.3"
  }
}
