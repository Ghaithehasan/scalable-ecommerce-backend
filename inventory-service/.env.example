# gRPC server
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Inventory database — the service owns it exclusively (database per service).
# It must never point at the main application's database.
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=inventory

# Safety net: PostgreSQL aborts any statement that runs longer than this.
DB_STATEMENT_TIMEOUT_MS=5000

# Demo only. When > 0, ReserveStock sleeps this long before doing any work, so
# a client with a shorter deadline can be shown receiving DEADLINE_EXCEEDED.
# Keep it at 0 everywhere except during the demonstration.
INVENTORY_ARTIFICIAL_DELAY_MS=0

# error | warn | log | debug | verbose (comma separated)
LOG_LEVELS=error,warn,log
